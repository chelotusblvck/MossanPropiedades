# --- Servidor ---
PORT=4000
DB_PATH=./data/propiedades.db
FRONTEND_URL=http://localhost:5173

# Contraseña del panel /admin (usa una larga; cambiarla cierra todas las sesiones)
ADMIN_PASSWORD=
# Clave para scripts/integraciones: header "x-api-key". Genera una larga y aleatoria.
ADMIN_API_KEY=
# true si corre detrás de un proxy (Nginx, Render, Railway…)
TRUST_PROXY=false

# --- Sitio y marca (se usan en los correos) ---
SITE_URL=http://localhost:5173
BRAND_NAME=Mi Inmobiliaria
CONTACT_PHONE=+56 9 1234 5678

# Comisión del corredor por defecto (se puede ajustar por propiedad en /admin)
COMISION_VENTA_PCT=2
COMISION_ARRIENDO_PCT=50
# Arriendo diario: % del arriendo cobrado que retiene la corredora al liquidar al propietario
# (COMISION_MAS_IVA=true también le suma el IVA de 19 % a esta comisión)
COMISION_DIARIO_PCT=20
COMISION_MAS_IVA=true

# Horas que tiene el cliente para pagar una reserva antes de que se libere automáticamente (0 = nunca)
RESERVA_PLAZO_PAGO_HORAS=24

# --- Pagos de reservas (arriendo diario) ---
# Webpay Plus (Transbank). Vacío = desactivado. "integracion" usa las credenciales públicas de prueba
# de Transbank (tarjetas de prueba, no cobra). En "produccion" completa código de comercio y API key.
WEBPAY_AMBIENTE=integracion
WEBPAY_CODIGO_COMERCIO=
WEBPAY_API_KEY=
# Mercado Pago (cuenta de Mercado Libre de la corredora): https://www.mercadopago.cl/developers/panel
# Usa el "Access Token" de producción (o de prueba, que empieza con TEST-). Vacío = desactivado.
MP_ACCESS_TOKEN=
# Transferencia bancaria (vacío BANCO_NUMERO_CUENTA = desactivado)
BANCO_NOMBRE=
BANCO_TIPO_CUENTA=Cuenta Corriente
BANCO_NUMERO_CUENTA=
BANCO_TITULAR=
BANCO_RUT=
BANCO_EMAIL=

# --- Agenda (arriendo diario) ---
HORA_CHECKIN=15:00
HORA_CHECKOUT=11:00
# Punto de partida de la ruta de entrega de llaves (ej. la oficina)
ORIGEN_RUTA=

# --- Correo (SMTP) para avisos de reservas ---
# Sin SMTP_HOST los correos se muestran en la consola (modo desarrollo).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true y una "contraseña de aplicación".
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Remitente, ej: "Mi Inmobiliaria <reservas@miinmobiliaria.cl>"
MAIL_FROM=
# Quién recibe el aviso de nueva reserva (uno o varios, separados por coma)
NOTIFY_EMAIL=
# Enviar también acuse de recibo al cliente
NOTIFY_CLIENT=true

# --- Respaldos (base de datos + imágenes) ---
# Carpeta de respaldos (no se sube a git: contiene datos personales de clientes)
BACKUP_DIR=./backups
# Carpeta de imágenes subidas al servidor que se incluye en el ZIP
UPLOADS_DIR=./uploads
# Respaldo automático diario (hora de Chile) y al iniciar el servidor
BACKUP_AUTO=true
BACKUP_HORA=2
# Cantidad de respaldos automáticos que se conservan (los más antiguos se eliminan)
BACKUP_CONSERVAR=30
# Al iniciar, sólo respalda si el último automático tiene más de estas horas (0 = siempre)
BACKUP_MIN_HORAS_INICIO=6
# Tamaño máximo de un archivo subido para restaurar (MB)
BACKUP_MAX_SUBIDA_MB=1024

# --- WhatsApp (Meta Cloud API) para los códigos de acceso del portal de propietarios ---
# https://developers.facebook.com/docs/whatsapp/cloud-api · Vacío = los códigos se envían sólo por correo
# (sin SMTP, en desarrollo el código aparece en la consola del servidor).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Nombre de una plantilla de categoría "Autenticación" aprobada (con botón "copiar código")
WHATSAPP_PLANTILLA_CODIGO=
WHATSAPP_IDIOMA=es

# Valor UF de respaldo si mindicador.cl no responde
UF_FALLBACK=40000

# --- Mercado Libre / Portalinmobiliario (OAuth2) ---
# Crea tu aplicación en https://developers.mercadolibre.cl/devcenter
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
# Debe coincidir EXACTAMENTE con la "URI de redirect" configurada en la app (en producción debe ser HTTPS)
MELI_REDIRECT_URI=http://localhost:4000/api/mercadolibre/callback
MELI_AUTH_URL=https://auth.mercadolibre.cl/authorization
# Usa PKCE (recomendado; actívalo también en la configuración de tu app)
MELI_USE_PKCE=true
# Sincronización automática cada N minutos (0 = desactivada)
MELI_SYNC_INTERVAL_MINUTES=60
